<div class="collection-carousel__header">
  <div class="collection-carousel__text">
    {% if heading != blank %}
      <h2>{{ heading }}</h2>
    {% endif %}
    {% if subheading != blank %}
      <p class="collection-carousel__subheading">{{ subheading }}</p>
    {% endif %}
  </div>

  {% if collection and collection.url %}
    <a
      href="{{ collection.url }}"
      class="collection-carousel__view-all"
    >
      View all
    </a>
  {% endif %}
</div>
