{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
{{ 'collection-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-carousel.js' | asset_url }}" defer></script>

{% liquid
  assign collection = section.settings.collection
  assign max_products = section.settings.max_products | default: 4
  assign heading_text = section.settings.heading
  assign subheading_text = section.settings.subheading

  if heading_text == blank and collection != blank
    assign heading_text = collection.title
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    collection-carousel-section
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="collection-carousel__container">
    {% render 'collection-carousel-header',
      heading: heading_text,
      subheading: subheading_text,
      collection: collection
    %}

    {% if collection != blank and collection.products_count > 0 %}
      <div class="swiper collection-carousel__swiper">
        <div class="swiper-wrapper">
          {% for product in collection.products limit: max_products %}
            <div class="swiper-slide">
              {% render 'collection-carousel-product-card', product: product %}
            </div>
          {% endfor %}
        </div>

        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    {% else %}
      <p class="collection-carousel__empty">
        {{ 'content.no_products_found' | t }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Carousel",
  "class": "ui-test-collection-carousel",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Collection Carousel",
      "category": "Products",
      "settings": {
        "max_products": 8,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
