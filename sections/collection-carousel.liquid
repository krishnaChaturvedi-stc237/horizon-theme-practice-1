{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
{{ 'collection-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-carousel.js' | asset_url }}" defer></script>

{% liquid
   assign collection = section.settings.collection
   assign max_products = section.settings.max_products | default: 4
%}

{% if collection != blank %}
    <section
     class="collection-carousel-section"
     data-section-id="{{ section.id }}"
     data-show-pagination="{{section.settings.show_pagination}}"
    >
      <div class="collection-carousel__container">

         {% render 'collection-carousel-header', 
            heading: section.settings.heading | default: collection.title,
            collection: collection
         %}

         <div class="swiper collection-carousel__swiper" >
            <div class="swiper-wrapper" >
                {% for product in collection.products limit: max_products %}
                    <div class="swiper-slide">
                        {% comment %} {% render 'collection-carousel-product-card', product: product %} {% endcomment %}
                         <div>{{ product.title }}</div>
                    </div>
                {% endfor %}
            </div>
            {% if section.settings.show_pagination %}
                <div class="swiper-pagination"></div>
            {% endif %}

         </div>

      </div>


    </section>

{% endif %}

{%  schema  %} 
{
    "name": "Collection Carousel",
    "tag" : "section",
    "class": "collection-carousel",
    "settings": [
      {
        "type": "collection",
        "id" : "collection",
        "label": "Select Collection"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "range",
        "id": "max_products",
        "label": "Maximum Products to Show",
        "min": 1,
        "max": 20,
        "step": 1,      
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show Pagination",
        "default": false
      }
    ],
    "presets": [
      {
        "name": "Collection Carousel",
        "category": "Products"
      }
    ]

}
{% endschema %}