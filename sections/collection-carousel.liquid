{% liquid
   assign collection = section.settings.collection
   assign max_products = section.settings.max_products | default: 4
%}

{% if collection != blank %}

{% endif %}

{%  schema  %} 
{
    "name": "Colection Carousel",
    "tag" : "section",
    "class": "collection-carousel",
    "settings": [
      {
        "type": "collection",
        "id" : "colletion",
        "label": "Select Collection"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Collection Carousel"
      },
      {
        "type": "range",
        "id": "max_products",
        "label": "Maximum Products to Show",
        "min": 1,
        "max": 20,
        "step": 1,      
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show Pagination",
        "default": false
      }
    ],
    "presets": [
      {
        "name": "Collection Carousel",
        "category": "Products"
      }
    ]

}
{% endschema %}