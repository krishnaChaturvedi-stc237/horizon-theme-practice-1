{% schema %}
{
  "name": "Custom Collection Section",
  "settings": [],
  "presets": [
    {
      "name": "Custom Collection"
    }
  ]
}
{% endschema %}

<style>
.collection-section {
  padding: 40px 20px;
}

.title {
  text-align: center;
  font-size: 28px;
  margin-bottom: 30px;
}

.collection-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.card {
  position: relative;
  overflow: hidden;
}

.card img {
  width: 100%;
  transition: 0.4s;
}

.card:hover img {
  transform: scale(1.1);
}

.overlay {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
}

.overlay button {
  padding: 10px 20px;
  border: 1px solid black;
  background: transparent;
  cursor: pointer;
}

@media(min-width:700px){
  .collection-grid {
    grid-template-columns: repeat(2,1fr);
  }
}

@media(min-width:1150px){
  .collection-grid {
    grid-template-columns: repeat(3,1fr);
  }
}
</style>

<section class="collection-section">
  <h2 class="title">Shop Our Signature Collection</h2>

  <div class="collection-grid">

    <a href="#" class="card">
      <img src="https://via.placeholder.com/400x500">
      <div class="overlay">
        <button>DISCOVER</button>
      </div>
    </a>

    <a href="#" class="card">
      <img src="https://via.placeholder.com/400x500">
      <div class="overlay">
        <button>DISCOVER</button>
      </div>
    </a>

    <a href="#" class="card">
      <img src="https://via.placeholder.com/400x500">
      <div class="overlay">
        <button>DISCOVER</button>
      </div>
    </a>

  </div>
</section>